# Keep source code line endings consistent
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Windows scripts can stay CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pth binary
*.pt binary
*.ckpt binary
*.npy binary
*.npz binary